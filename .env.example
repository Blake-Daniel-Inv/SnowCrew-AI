# ============================================================
# Per-user credential encryption (PR 1)
# ============================================================
# Master key used to wrap per-row data keys for encrypted
# credentials (GitHub OAuth tokens, PATs, etc).
# Generate with: openssl rand -base64 32
# REQUIRED to use the integrations feature.
CREDENTIALS_MASTER_KEY=

# ============================================================
# GitHub OAuth (PR 2)
# ============================================================
# Register an OAuth App at https://github.com/settings/developers
# and copy the Client ID + Client Secret here. The callback URL
# you register in GitHub must match GITHUB_OAUTH_CALLBACK_URL
# below (or, if unset, the auto-derived
# <request-origin>/api/auth/github/callback).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional; auto-derived from request origin if unset. Set to
# https://your-host/api/auth/github/callback for production
# deployments where the public origin is fixed.
GITHUB_OAUTH_CALLBACK_URL=
# When a Studio agent declares the `github` tool in its tools array,
# the Node runner injects the OAuth token from the encrypted credential
# store (see CREDENTIALS_MASTER_KEY above) into the python subprocess as
# GITHUB_TOKEN at run start. There is no env var to set here — the token
# is pulled from the per-user encrypted row. GITHUB_TOKEN_AVAILABLE='1'
# is also injected so the python tool can short-circuit fast when the
# credential is present.

# ============================================================
# Scheduler (PR 15)
# ============================================================
# In-app cron daemon for workflow scheduling. Runs in-process
# (single-container SPCS deploy), polls every 60s by default,
# claims due schedules from the SQLite `schedules` table.
#
# Missed-run policy: NO BACKFILL. If the container is down at a
# scheduled time we skip and fire next at the regular cadence.
#
# Poll interval in ms. Clamped to [10_000, 300_000]; values
# outside the range fall back to the lower/upper bound.
SCHEDULER_POLL_MS=60000
# Operator escape hatch — set to '1' to disable the daemon
# entirely (no schedules will fire). Useful for incident response
# without redeploying.
SCHEDULER_DISABLED=
